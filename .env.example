# Copiá este archivo como .env (para probar en tu compu) y cargá lo mismo en Vercel → Settings → Environment Variables.
# La dirección de la base de Neon (Neon → Connection string). Para probar con un Postgres local: postgres://usuario:clave@localhost:5432/aventuras
DATABASE_URL=
# Una frase larga al azar para firmar las sesiones. Por ejemplo, el resultado de: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Tu email. La cuenta que se registra con este email es la del administrador.
ADMIN_EMAIL=
