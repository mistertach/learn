# Copiá este archivo como .env (para probar en tu compu) y cargá lo mismo en Vercel → Settings → Environment Variables.
# La dirección de la base de Neon (Neon → Connection string). Para probar con un Postgres local: postgres://usuario:clave@localhost:5432/aventuras
DATABASE_URL=
# Una frase larga al azar para firmar las sesiones. Por ejemplo, el resultado de: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Tu email. La cuenta que se registra con este email es la del administrador.
ADMIN_EMAIL=
# Opcional, para el email de "¿Te olvidaste la contraseña?" (con https://resend.com). Sin esto, en tu compu el link
# aparece en la consola; online, el juego le dice al grande que te pida una contraseña nueva (admin → Nueva contraseña).
RESEND_API_KEY=
# El remitente, de un dominio verificado en Resend. Por ejemplo: Las aventuras <hola@tudominio.com>
MAIL_FROM=
# La dirección del juego, para armar el link del email. Por ejemplo: https://tujuego.vercel.app
APP_URL=
# Opcional, solo para comparar voces (node scripts/voces-prueba.js). No hacen falta para jugar.
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
